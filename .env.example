# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin password for managing knowledge base, memory & API settings (Default: 123456)
VITE_ADMIN_PASSWORD="123456"

# Optional Client-side Gemini API Key (for Vercel SPA deployment without server proxy)
VITE_GEMINI_API_KEY=""

# Optional Firebase configuration (for global Firestore document sync on Vercel)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
